{
  "name": "berlin-sublet",
  "version": "1.0.0",
  "private": true,
  "description": "Berlin direct subletting platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "postinstall": "npm install --prefix client --include=dev && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
